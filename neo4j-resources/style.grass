node {
  diameter: 50px;
  color: #A5ABB6;
  border-color: #9AA1AC;
  border-width: 2px;
  text-color-internal: #FFFFFF;
  font-size: 10px;
}
relationship {
  color: #A5ABB6;
  shaft-width: 1px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #000000;
  text-color-internal: #FFFFFF;
  caption: '<type>';
}
node.host {
  diameter: 65px;
  color: #57C7E3;
  border-color: #23B3D7;
  caption: '{name}';
}
node.origen {
  diameter: 80px;
  color: #F16667;
  border-color: #EB2728;
  caption: '{name}';
}
